{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev --port 3000",
    "build": "bunx --bun vite build",
    "start": "bun run .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "build:cloudflare": "NITRO_PRESET=cloudflare_module bun run build",
    "deploy": "bun run build:cloudflare && bunx wrangler deploy",
    "deploy:dry": "bun run build:cloudflare && bunx wrangler deploy --dry-run"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.7.6",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "nitro": "^3.0.260903-beta",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0",
    "wrangler": "^4.152.0"
  }
}
