DATABASE_URL=postgres://todo:todo@localhost:5432/todo
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001
PORT=3001
NODE_ENV=development
# Comma-separated browser origins; add your LAN origin when testing web remotely.
TRUSTED_ORIGINS=http://localhost:8081,http://localhost:8082
# Android emulator: http://10.0.2.2:3001; physical device: http://YOUR_MAC_LAN_IP:3001
# EXPO_PUBLIC_API_URL=http://localhost:3001

# Optional Sarvam AI. Server only; never prefix this with EXPO_PUBLIC_.
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
